# Insof ECO mobil — lokal `.env` namunasi (`cp .env.example .env`). `.env` git'ga tushmaydi.
#
# Production/preview build va OTA bu faylni EMAS, EAS → Environment variables (`production` muhit) ni oladi:
#   eas env:list --environment production
#   eas update --channel production --environment production --message "..."   # --environment SHART
# `--environment` siz `eas update` shu lokal .env ni to'plamga yozadi — ilova production'da LAN IP'ga ulanadi.

# ECO API (NestJS). Lokal: http://<Mac IP>:3010 (telefon Wi-Fi'da), production: https://api.insof-erp.uz
EXPO_PUBLIC_API_URL=http://192.168.1.10:3010
# Insof ERP (zavod xodimlari login bilan shu yerga kiradi; /maxfiylik ham shu domenda). Production: https://insof-erp.uz
EXPO_PUBLIC_ERP_URL=http://192.168.1.10:3000

# Yandex (developer.tech.yandex.ru). MapKit — xarita (kalitsiz build'da xarita o'rnida ro'yxat chiqadi).
EXPO_PUBLIC_YANDEX_MAPKIT_KEY=
# Ixtiyoriy zaxira: HTTP Geosuggest (manzil takliflari) va HTTP Geocoder (koordinata ↔ manzil)
EXPO_PUBLIC_YANDEX_GEOSUGGEST_KEY=
EXPO_PUBLIC_YANDEX_GEOCODER_KEY=

# "Ilovani yangilang" ekrani (server 426 / APP_UPDATE_REQUIRED havola bermasa). Android standarti — Play Market sahifasi.
EXPO_PUBLIC_IOS_STORE_URL=
EXPO_PUBLIC_ANDROID_STORE_URL=
# Ixtiyoriy: qo'llab-quvvatlash Telegram'i (https://t.me/...) — bo'lsa yangilash ekranida tugma chiqadi
EXPO_PUBLIC_SUPPORT_TELEGRAM=

# Ixtiyoriy: EAS loyiha ID (standart — app.config.ts dagi)
# EAS_PROJECT_ID=
# Android push (FCM): EAS'da "file" turidagi env sifatida (production), lokalda — apps/mobile/google-services.json
# GOOGLE_SERVICES_JSON=
