NODE_ENV=development
# dev: rate-limitni o'chirish (smoke-test uchun); prod'da e'tiborsiz
THROTTLE_DISABLED=true
PORT=3010
# pino: trace|debug|info|warn|error (prod: info)
LOG_LEVEL=info
DATABASE_URL=postgresql://insof:insof@localhost:5438/insof?schema=public
# infra/docker-compose.prod.yml shu fayldan o'qiydi (--env-file): parol DATABASE_URL dagisi bilan bir xil bo'lsin
POSTGRES_USER=insof
POSTGRES_PASSWORD=
POSTGRES_DB=insof
REDIS_URL=redis://localhost:6382
# RS256 kalitlar (dev uchun: openssl genrsa -out jwt.key 2048 && openssl rsa -in jwt.key -pubout -out jwt.pub) — PEM ni \n bilan bitta qatorga
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30
# dev: FAKE (OTP har doim 000000), prod: ESKIZ
SMS_PROVIDER=FAKE
ESKIZ_EMAIL=
# Kabinet paroli EMAS — "Sozlamalar → API" bo'limidagi API paroli
ESKIZ_PASSWORD=
# Tasdiqlangan jo'natuvchi nomi (masalan INSOF). Bo'sh bo'lsa Eskiz sinov nomi 4546 ishlatiladi —
# SMS "yuborildi" bo'lib ko'rinadi, lekin haqiqiy raqamga yetib bormaydi.
ESKIZ_FROM=
# Telegram Gateway (https://gateway.telegram.org) — kirish kodi foydalanuvchining Telegram'iga boradi.
# Token bo'lsa OTP avval Telegram'ga, raqamda Telegram yo'q bo'lsa SMS'ga (ESKIZ) yuboriladi.
TELEGRAM_GATEWAY_TOKEN=
# Ixtiyoriy: kod tasdiqlangan kanal nomidan kelsin (username, @ siz)
TELEGRAM_GATEWAY_SENDER=
# Ro'yxatdan o'tishda telefon egaligi (Telegram/SMS kodi) majburiy. Sukut: true.
# Ilova 1.0.2+ avval /auth/register/verify dan `phoneVerificationToken` oladi. Eski 1.0.0/1.0.1 ilovalar tokensiz
# yuboradi — true bo'lganda ular ro'yxatdan O'TA OLMAYDI (kod bilan kirish ishlaydi). O'tish davrida vaqtincha false
# qo'yish mumkin, lekin bunda yangi raqamni begona odam oldindan egallashi mumkin (xavfsizlik teshigi).
REGISTER_OTP_REQUIRED=true
# Taklif qilingan haydovchiga SMS'da yuboriladigan ilova havolasi (Play Market / App Store / apk)
ECO_APP_URL=
S3_ENDPOINT=http://localhost:9010
S3_BUCKET=insof
S3_ACCESS_KEY=insof
S3_SECRET_KEY=insofinsof
# SigV4 imzo regioni (MinIO standarti us-east-1)
S3_REGION=us-east-1
# API serveri ichidan HEAD/DELETE uchun (masalan http://minio:9000); bo'lmasa S3_ENDPOINT
# S3_INTERNAL_ENDPOINT=
EXPO_ACCESS_TOKEN=
# Telegram orqali kirish — zavodning mavjud boti (Insof ERP boti) username'i, @ siz.
# Update'larni ERP oladi va /v1/erp/telegram-login/* ga uzatadi. Bo'sh bo'lsa tugma "sozlanmagan" deydi.
TELEGRAM_BOT_USERNAME=
# Superadmin (dasturchi): huquq `yarn workspace @insof/api superadmin +998…` bilan beriladi.
# Shu yerda raqamlar berilsa — ikkinchi qulf: /admin/* faqat bayrog'i bor VA ro'yxatdagi raqamga ochiladi.
SUPERADMIN_PHONES=
# Superadmin "Holat" ekrani: Insof ERP serveri manzili (/health tekshiriladi) yoki to'liq health URL
ERP_URL=
ERP_HEALTH_URL=
# Deploy paytida commit (holat ekranida ko'rinadi)
GIT_COMMIT=

# Haydovchi "yetib keldim/yetkazdim" so'rovida koordinata majburiymi. false — eski (1.0.0) ilova ham reysni yopa oladi.
# true faqat 1.0.1 hamma haydovchida o'rnatilgach (docs/07-dokonga-chiqarish.md → "Koordinata bayroqlari").
# ERP tomonidagi juftligi: MOBILE_SITE_COORDS_REQUIRED (Insof ERP .env)
SITE_COORDS_REQUIRED=false

